#Aligning the cut_reads using bowtie2
#fix up the chip-seq script to use Chr1 instead of a simmed ref genome


# connect chain cutadapt ----> fastqc
#                          |
#                          |---->align_reads

# Similar to the conditional issue with cutadapt and making this script more generalizable (sim_reads vs reals_reads)
# We have to make a bowtie input function due to way snakemake will parse then execute the rules
# This similar to what had to happen with the fastqc condition and rule.
#Personal Note. Very interesting to learn more about the python/snakemake interactions


rule bowtie2_alignment_paired:
    input:
        r1="../chip_output/chip_cutadapt/{prefix}_1.trimmed.fastq",
        r2="../chip_output/chip_cutadapt/{prefix}_2.trimmed.fastq"
    output:
        "../chip_output/aligned_chip_reads/{prefix}.sam"
    threads: 32
    params:
        ref_dir="../data/chip_data",
        ref_fa="../data/chip_data/mm10.fa",
        ref_url="https://hgdownload.soe.ucsc.edu/goldenPath/mm10/bigZips/mm10.fa.gz",
        index="../chip_output/aligned_chip_reads/mm10_index"
    shell:
        """
        mkdir -p {params.ref_dir} &&
        mkdir -p ../chip_output/aligned_chip_reads &&

        # Download and decompress mm10 reference
        wget -O {params.ref_fa}.gz {params.ref_url} &&
        gunzip -c {params.ref_fa}.gz > {params.ref_fa} &&

        # Index reference with bowtie2-build
        bowtie2-build --threads {threads} {params.ref_fa} {params.index} &&

        # Run bowtie2 paired-end alignment
        bowtie2 -x {params.index} \
            -1 {input.r1} -2 {input.r2} \
            -S {output} --local -p {threads} &&

        # Cleanup reference files after indexing
        rm {params.ref_fa}.gz {params.ref_fa}
        """
            
            
# SAM --(SAMtools view)--> BAM --(SAMtools sort)--> Sorted BAM --(SAMtools rmdup)--> Deduplicated BAM

rule prepsam_deduplicate_paired:
    input:
        sam="../chip_output/aligned_chip_reads/{prefix}.sam"
    output:
        intermediate_bam = temp("../chip_output/sorted_bam/{prefix}_fixmate_unsorted.bam"),
        sorted_bam="../chip_output/sorted_bam/{prefix}_sorted.bam",
        sorted_bam_index="../chip_output/sorted_bam/{prefix}_sorted.bam.bai",
        deduplicated_bam="../chip_output/sorted_bam/{prefix}_sorted_deduplicated.bam"
    threads: 16
    shell:
        """
        mkdir -p ../chip_output/sorted_bam &&

        # Step 1: Convert SAM to BAM
        samtools view -@ {threads} -bS {input.sam} > {wildcards.prefix}.unsorted.bam &&

        # Step 2: Add mate info (MC tag)
        samtools fixmate -m -@ {threads} {wildcards.prefix}.unsorted.bam {output.intermediate_bam} &&

        # Step 3: Sort fixed BAM
        samtools sort -@ {threads} -o {output.sorted_bam} {output.intermediate_bam} &&

        # Step 4: Index sorted BAM
        samtools index {output.sorted_bam} &&

        # Step 5: Remove duplicates
        samtools markdup -@ {threads} -r {output.sorted_bam} {output.deduplicated_bam} &&

        # Cleanup
        rm -f {wildcards.prefix}.unsorted.bam
        """

#set a condition later on where there is a condition and if there is no condition for now we have to just get it done
#
rule peak_call:
    input:
        deduplicated_bam="../chip_output/sorted_bam/{prefix}_sorted_deduplicated.bam"
    output:
        summits="../chip_output/macs2_output/{prefix}_summits.bed",
        peaks="../chip_output/macs2_output/{prefix}_peaks.narrowPeak"
    threads: 8
    shell:
        """
        mkdir -p ../chip_output/macs2_output &&
        macs2 callpeak \
            -t {input.deduplicated_bam} \
            -f BAM \
            -n {wildcards.prefix} \
            --outdir ../chip_output/macs2_output \
            --nomodel \
            --call-summits \
            -g mm \
            --keep-dup all
        """

# HOMER/ChIPseeker
#input files needed: mm10_chr1.gtf, chr1_limit.fa, peak_call_file.bed
rule homer_annotation:
    input:
        summits="../chip_output/macs2_output/{prefix}_summits.bed"
    output:
        ann_peaks="../chip_output/macs2_output/{prefix}_ann_peaks.txt"
    params:
        gtf_url="https://hgdownload.soe.ucsc.edu/goldenPath/mm10/bigZips/genes/mm10.ncbiRefSeq.gtf.gz",
        gtf_gz="../chip_output/tmp/mm10.ncbiRefSeq.gtf.gz",
        gtf="../chip_output/tmp/mm10.ncbiRefSeq.gtf"
    shell:
        """
        mkdir -p ../chip_output/tmp &&
        mkdir -p ../chip_output/macs2_output &&

        # Download and decompress GTF
        wget -O {params.gtf_gz} {params.gtf_url} &&
        gunzip -c {params.gtf_gz} > {params.gtf} &&

        # Run HOMER annotation
        annotatePeaks.pl {input.summits} mm10 -gtf {params.gtf} > {output.ann_peaks} &&

        # Cleanup GTF and temp directory
        rm -f {params.gtf} {params.gtf_gz} &&
        rmdir --ignore-fail-on-non-empty ../chip_output/tmp
        """
