#rule all defines the ultimate output of the 
rule all:
    input:
        "../chip_output/mac2_output/ann_peaks.txt"



def get_cut_input(wildcards):
        if wildcards.sample in SIM_SAMPLES:
        
            return f"../chip_output/chip_reads/{wildcards.sample}.fastq"
        else:
            return f"../chip_output/chip_cutadapt/cut_{wildcards.sample}.fastq"


rule cutadapt:
    input:
        "../data/{sample}.fastq"
    output:
        "../chip_output/chip_cutadapt/cut_{sample}.fastq"
    shell:
        """
        mkdir -p ../chip_output/chip_cutadapt &&
        cutadapt -a AGATCGGAAGAGC -o {output} {input}
        """
            

#connect chain cutadapt ---> fastqc
#seperate depedancies

rule fastqc:
        input:
            lambda wildcards: get_cut_input(wildcards)
            # wildcards are only available when Snakemake exectus a rule
            #When parsing the object wildcards doe snot exist yet
            #lamda essentially delays the function fun until the rule cutadapt has been exectuted
            
        output:
            "../chip_output/chip_fastqc_results/sim_reads_fastqc.html",
            "../chip_output/chip_fastqc_results/sim_reads_fastqc.zip"
        
        threads: 4
        
        shell:
            "mkdir -p ../chip_output/chip_fastqc_results && fastqc --outdir ../chip_output/chip_fastqc_results -t {threads} {input} - > {output}"
 
