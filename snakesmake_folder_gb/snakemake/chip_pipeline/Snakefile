import os
from glob import glob

# Identify Paired-end prefixes explicitly from *_1.fastq files
PAIRED_PREFIXES = [
    os.path.basename(f).replace("_1.fastq", "")
    for f in glob("../data/chip_data/*_1.fastq")
]

rule all:
    input:
        #chip_cutadpat
        expand("../chip_output/chip_cutadapt/{prefix}_1.trimmed.fastq", prefix=PAIRED_PREFIXES),
        expand("../chip_output/chip_cutadapt/{prefix}_2.trimmed.fastq", prefix=PAIRED_PREFIXES),
        
        #fastqc output
        expand("../chip_output/fastqc/{prefix}_1.trimmed_fastqc.html", prefix=PAIRED_PREFIXES),
        expand("../chip_output/fastqc/{prefix}_2.trimmed_fastqc.html", prefix=PAIRED_PREFIXES),
        
        #bowtie2_output
        expand("../chip_output/aligned_chip_reads/{prefix}.sam", prefix=PAIRED_PREFIXES),
        
        #sam_tpo_bam
        expand("../chip_output/sorted_bam/{prefix}_sorted.bam",prefix=PAIRED_PREFIXES),
        expand("../chip_output/sorted_bam/{prefix}_sorted.bam.bai",prefix=PAIRED_PREFIXES),
        expand("../chip_output/sorted_bam/{prefix}_sorted_deduplicated.bam", prefix=PAIRED_PREFIXES),
        
        #Peak_calling
        expand("../chip_output/macs2_output/{prefix}_summits.bed", prefix=PAIRED_PREFIXES),
        expand("../chip_output/macs2_output/{prefix}_peaks.narrowPeak", prefix=PAIRED_PREFIXES),
        
        #peak_calling
        expand("../chip_output/macs2_output/{prefix}_ann_peaks.txt", prefix=PAIRED_PREFIXES)
        
        
rule cutadapt_paired:
    input:
        r1="../data/chip_data/{prefix}_1.fastq",
        r2="../data/chip_data/{prefix}_2.fastq"
    output:
        r1_trimmed="../chip_output/chip_cutadapt/{prefix}_1.trimmed.fastq",
        r2_trimmed="../chip_output/chip_cutadapt/{prefix}_2.trimmed.fastq"
    threads: 8
    shell:
        """
        mkdir -p ../chip_output/chip_cutadapt &&
        cutadapt -j {threads} \
          -a AGATCGGAAGAGC \
          -A AGATCGGAAGAGC \
          -o {output.r1_trimmed} \
          -p {output.r2_trimmed} \
          {input.r1} {input.r2}
        """
        
rule fastqc_paired:
    input:
        r1_trimmed="../chip_output/chip_cutadapt/{prefix}_1.trimmed.fastq",
        r2_trimmed="../chip_output/chip_cutadapt/{prefix}_2.trimmed.fastq"
    output:
        r1_html="../chip_output/fastqc/{prefix}_1.trimmed_fastqc.html",
        r1_zip="../chip_output/fastqc/{prefix}_1.trimmed_fastqc.zip",
        r2_html="../chip_output/fastqc/{prefix}_2.trimmed_fastqc.html",
        r2_zip="../chip_output/fastqc/{prefix}_2.trimmed_fastqc.zip"
    threads: 8
    shell:
        """
        mkdir -p ../chip_output/fastqc &&
        fastqc -t {threads} -o ../chip_output/fastqc {input.r1_trimmed} {input.r2_trimmed}
        """        
        
        
