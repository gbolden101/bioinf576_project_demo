# Similar to the conditional issue with cutadapt and making this script more generalizable (sim_reads vs reals_reads)
# We have to make a bowtie input function due to way snakemake will parse then execute the rules
# This similar to what had to happen with the fastqc condition and rule.
#Personal Note. Very interesting to learn more about the python/snakemake interactions


rule bowtie2_alignment:
        input:
            fastq= "../data/sim_reads.fastq",
            reference="../sim_data/inputs/chr1_limit.fa"
        
        output:
            "../aligned_chip_reads/chip_alignments.sam"
    
        shell:
            """
            mkdir -p ../aligned_chip_reads &&
            bowtie2-build {input.reference} ../sim_data/inputs/chr1_limit &&
            bowtie2 -x ../sim_data/inputs/chr1_limit -q -U {input.fastq} -S {output} --local -p 8
            """
